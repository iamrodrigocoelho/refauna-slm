# Copie para .env (nunca versionado).
# Token do Hugging Face (leitura) — EmbeddingGemma é gated; alternativa: `hf auth login`.
HF_TOKEN=
# Pasta refauna-slm no Google Drive para desktop (contém data/ e outputs/).
REFAUNA_DRIVE_DIR="~/Library/CloudStorage/GoogleDrive-<conta>/Meu Drive/refauna-slm"
# Opcional: juiz LLM em `refauna eval --judge` (requer internet).
ANTHROPIC_API_KEY=
